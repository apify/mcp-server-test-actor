{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "title": { "type": "string" },
            "author": { "type": "string" },
            "pages": { "type": "integer" },
            "rating": { "type": "number" },
            "inStock": { "type": "boolean" },
            "scrapedAt": { "type": "string", "format": "date-time" },
            "tags": {
                "type": "array",
                "items": { "type": "string" }
            },
            "publication": {
                "type": "object",
                "properties": {
                    "year": { "type": "integer" },
                    "publisher": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "city": { "type": "string" }
                        }
                    }
                }
            },
            "reviews": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "quote": { "type": "string" },
                        "source": { "type": "string" },
                        "rating": { "type": "integer" },
                        "reviewer": {
                            "type": "object",
                            "properties": { "name": { "type": "string" } }
                        }
                    },
                    "required": ["quote", "source"]
                }
            },
            "#_internal": {
                "type": "object",
                "description": "Hidden field (key starts with '#'). Stripped when items are fetched with clean=true / skipHidden=true.",
                "properties": {
                    "sourceUrl": { "type": "string", "format": "uri" },
                    "runId": { "type": "string" }
                }
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "All book fields. Each field uses a different JSON type to exercise storage tool paths.",
            "transformation": {
                "fields": ["title", "author", "pages", "rating", "inStock", "scrapedAt", "tags", "publication", "reviews"],
                "flatten": ["publication"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": { "label": "Title", "format": "text" },
                    "author": { "label": "Author", "format": "text" },
                    "pages": { "label": "Pages", "format": "number" },
                    "rating": { "label": "Rating", "format": "number" },
                    "inStock": { "label": "In stock", "format": "boolean" },
                    "scrapedAt": { "label": "Scraped at", "format": "date" },
                    "tags": { "label": "Tags", "format": "array" },
                    "reviews": { "label": "Reviews", "format": "array" }
                }
            }
        }
    }
}

{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "title": { "type": "string" },
            "author": { "type": "string" },
            "pages": { "type": "integer" },
            "rating": { "type": "number" },
            "inStock": { "type": "boolean" },
            "tags": {
                "type": "array",
                "items": { "type": "string" }
            },
            "publication": {
                "type": "object",
                "properties": {
                    "year": { "type": "integer" },
                    "publisher": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "city": { "type": "string" }
                        }
                    }
                }
            },
            "reviews": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "quote": { "type": "string" },
                        "source": { "type": "string" }
                    }
                }
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "All book fields. Each field uses a different JSON type to exercise storage tool paths.",
            "transformation": {
                "fields": ["title", "author", "pages", "rating", "inStock", "tags", "publication", "reviews"],
                "flatten": ["publication"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": { "label": "Title", "format": "text" },
                    "author": { "label": "Author", "format": "text" },
                    "pages": { "label": "Pages", "format": "number" },
                    "rating": { "label": "Rating", "format": "number" },
                    "inStock": { "label": "In stock", "format": "boolean" },
                    "tags": { "label": "Tags", "format": "array" },
                    "reviews": { "label": "Reviews", "format": "array" }
                }
            }
        },
        "byPublisher": {
            "title": "By publisher",
            "description": "Compact view focused on publishing house and city.",
            "transformation": {
                "fields": ["title", "publication.publisher.name", "publication.publisher.city", "publication.year"],
                "flatten": ["publication"]
            },
            "display": {
                "component": "table"
            }
        }
    }
}
